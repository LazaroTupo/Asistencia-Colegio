# /home/lazaro/Workspace/Asistencia-Colegio/backend/.env

# --------------------------
# Configuración de Base de Datos
# --------------------------
# IMPORTANTE: Aquí SÍ se usa localhost, porque el backend se conecta 
# desde tu máquina al puerto 5432 que expuso Docker Compose.
# El usuario, contraseña y base de datos deben coincidir con el compose.
DATABASE_URL="postgresql://postgres:<password>@<host>:<port>/<db_name>?schema=public"

# --------------------------
# Configuración de Evolution API
# --------------------------
# La URL donde está corriendo el Evolution API localmente
EVOLUTION_API_URL="http://localhost:8080"

# La misma llave exacta que pusiste en el .env de la raíz del proyecto
EVOLUTION_API_KEY="AAAAAAAAAAAAAAAAAAAAAAA"

# --------------------------
# Configuración del Servidor Backend
# --------------------------
# Puerto donde correrá tu backend
PORT=3000

# Entorno de ejecución (cambiar a production cuando lo subas a producción)
NODE_ENV=development
